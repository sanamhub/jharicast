<Project Sdk="Microsoft.NET.Sdk">
  <!-- Not published to nuget.org until DHM, DoR and BIPAD answer the permission request, or the
       maintainer records a decision (ADR-0007, ADR-0014). release.yml holds it back. -->
  <PropertyGroup>
    <RootNamespace>Jharicast.Nepal</RootNamespace>
    <Description>Nepal pack for Jharicast: the 77 districts with every spelling seen in official sources, towns, and parsers for DHM, BIPAD and DoR feeds. Data belongs to those agencies.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Jharicast/Jharicast.csproj" />
    <ProjectReference Include="../Jharicast.Fetch/Jharicast.Fetch.csproj" />
    <!-- NepalRouteAssessor joins routing and model data with the official sources.
         ADR-0003 allows the Routing reference; nothing references Nepal back. -->
    <ProjectReference Include="../Jharicast.OpenMeteo/Jharicast.OpenMeteo.csproj" />
    <ProjectReference Include="../Jharicast.Routing/Jharicast.Routing.csproj" />
  </ItemGroup>
  <!-- The embedded data keeps its own licence (CC BY-IGO 3.0 for boundaries, ODbL for towns),
       and both require the credit to travel with the data. -->
  <ItemGroup>
    <None Include="../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
